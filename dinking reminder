import time
import winsound
from plyer import notification

while True:

    choice = input("Press Enter to start reminder or type 'stop' to exit: ")

    if choice.lower() == "stop":
        break

    print("Waiting for 10 second...")

    time.sleep(10)

    notification.notify(
        title="💧 Water Reminder",
        message="Time to drink water!",
        timeout=5
    )

    winsound.Beep(1000, 1000)

print("Water Reminder stopped.")
